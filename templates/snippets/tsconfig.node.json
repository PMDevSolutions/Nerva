{
  "extends": "../shared/tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "bundler",
    "rootDir": ".",
    "rootDirs": ["shared/src", "node/src"],
    "paths": {}
  },
  "include": [
    "shared/src/**/*.ts",
    "node/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/tests/**",
    "cloudflare/**"
  ]
}
